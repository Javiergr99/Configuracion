# auth_service: autenticación, refresh, /users/me y administración.
VITE_API_URL=

# Los mocks administrativos solo pueden habilitarse en desarrollo local.
VITE_ENABLE_ADMIN_MOCKS=false

# Frontend de autenticación universal. Ejemplo de producción:
# http://SERVIDOR:5174/login
VITE_AUTH_APP_URL=

# Puerto local sugerido para Configuración: 5180.
# auth_service debe autorizar como redirect-code exactamente:
# http://127.0.0.1:5180/app/dashboard
